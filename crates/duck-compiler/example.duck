extern:
	fn logi(num: i32)
	fn logf(num: f32) = "log_f32"
	fn logs(text: array(u8)) = "log_str"

pub let global = true
pub var counter = 0
pub let greeting = "Hello, duck!"
pub let primes: array(u8) = [2, 3, 5, 7]

pub struct Point:
	x: f32
	y: f32

pub fn add(a: i32, b: i32) -> i32:
	return a + b

# Entry point
pub fn main():
	let a = 1
	let b = 2
	let c = add(a, b)
	logi(c)
	logf(1.5)
	logs(greeting)
	for p in primes:
		logi(p as i32)
	var i = 0
	while i < 3:
		i += 1
		continue
	while true:
		break
